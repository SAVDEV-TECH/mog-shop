rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin (supports custom claims + admin emails)
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.admin == true ||
         request.auth.token.email == 'savde388@gmail.com' || 
         request.auth.token.email.matches('.*@mogshop\\.com$'));
    }

    // User profile, saved delivery address, and synced cart/wishlist
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Settings collection rules
    match /settings/{settingId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // Coupons / promo codes collection rules
    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products collection rules
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.reviewCount is number &&
        request.resource.data.reviewCount >= 0
      );

      // Reviews subcollection rules under products
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      }
    }

    // Orders collection rules
    match /orders/{orderId} {
      // Orders are created only by the server (/api/create-order and the
      // Paystack webhook) using the Admin SDK, which bypasses these rules.
      // Blocking client writes stops forged orders with arbitrary totals/status.
      allow create: if false;

      // Only admins or the signed-in owner can read orders.
      // Guests view their receipt via /api/orders/{id}?token=... (server-side check).
      allow get, list: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);

      // Only admins can change or delete orders (status updates, etc.)
      allow update, delete: if isAdmin();
    }

    // Server-only collections (accessed exclusively via the Admin SDK)
    match /pendingCheckouts/{reference} {
      allow read, write: if false;
    }
    match /paymentReferences/{reference} {
      allow read, write: if false;
    }
    
    // Top-level Reviews collection rules
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // Credits collection rules (Debt Tracker)
    match /credits/{creditId} {
      allow read, write: if isAdmin();
    }
  }
}
