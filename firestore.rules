rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'savde388@gmail.com' || 
         request.auth.token.email.matches('.*@mogshop\\.com$'));
    }

    // Settings collection rules
    match /settings/{settingId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // Products collection rules
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Reviews subcollection rules under products
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      }
    }

    // Orders collection rules
    match /orders/{orderId} {
      // Validate order creation: logged-in user or guest with valid fields
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid)
        || (request.resource.data.isGuest == true 
            && request.resource.data.total is number 
            && request.resource.data.total > 0
            && request.resource.data.items is list
            && request.resource.data.items.size() > 0);
      
      // Only admins, the user who created it, or guest who placed it can view a specific order
      allow get: if isAdmin() 
        || (request.auth != null && resource.data.userId == request.auth.uid)
        || (resource.data.isGuest == true);

      // Only admins or the owner can query multiple orders or update them
      allow list, update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    // Top-level Reviews collection rules
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // Credits collection rules (Debt Tracker)
    match /credits/{creditId} {
      allow read, write: if isAdmin();
    }
  }
}
